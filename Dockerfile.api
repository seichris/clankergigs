FROM node:22.23.4-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.14.4 --activate
WORKDIR /app
COPY . .
RUN pnpm install --prod=false --frozen-lockfile --filter @gh-bounties/api... \
    && pnpm --filter @gh-bounties/api build

ENV NODE_ENV=production
# Preserve the existing deployment startup and migration behavior.
CMD ["sh", "-c", "cd apps/api && pnpm prisma:migrate:deploy && node dist/index.js"]
