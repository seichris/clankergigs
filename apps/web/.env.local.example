# Used only to scope the legacy NEXT_PUBLIC_RPC_URL. Deployments come from GET /networks.
NEXT_PUBLIC_CHAIN_ID=31337
# Local / fallback RPC (Anvil, custom chains, etc.)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# Ethereum RPCs (comma-separated lists for the selected chain; mainnet also used for ENS)
NEXT_PUBLIC_RPC_URLS_ETHEREUM_MAINNET=
NEXT_PUBLIC_RPC_URLS_ETHEREUM_SEPOLIA=
# Legacy (single URL)
NEXT_PUBLIC_RPC_URL_ETHEREUM_MAINNET=
NEXT_PUBLIC_RPC_URL_ETHEREUM_SEPOLIA=
# Optional public browser RPC map (never put server RPC credentials here).
# NEXT_PUBLIC_NETWORK_RPC_URLS_JSON={"1":["https://example.com/mainnet"],"11155111":["https://example.com/sepolia"]}
NEXT_PUBLIC_NETWORK_RPC_URLS_JSON=
NEXT_PUBLIC_API_URL=http://localhost:8787

# Legacy deployment origins (not used by the runtime network selector).
# Example:
#   NEXT_PUBLIC_WEB_ORIGIN_ETHEREUM_MAINNET=https://www.clankergigs.com
#   NEXT_PUBLIC_WEB_ORIGIN_ETHEREUM_SEPOLIA=https://sepolia.clankergigs.com
#   NEXT_PUBLIC_WEB_ORIGIN_SUI=https://sui.clankergigs.com
NEXT_PUBLIC_WEB_ORIGIN_ETHEREUM_MAINNET=
NEXT_PUBLIC_WEB_ORIGIN_ETHEREUM_SEPOLIA=
NEXT_PUBLIC_WEB_ORIGIN_SUI=

# Optional (deprecated): override ENS mainnet RPC.
NEXT_PUBLIC_ENS_RPC_URL=

NEXT_PUBLIC_ENS_DEMO_ADDRESS=
NEXT_PUBLIC_ENS_DEMO_NAME=
# Optional: override ENS text record `com.github` for the demo name.
# Set to "*" to force-match the connected GitHub user.
NEXT_PUBLIC_ENS_DEMO_COM_GITHUB=
