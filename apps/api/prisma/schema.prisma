generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Repo {
  id                String   @id @default(cuid())
  repoHash          String   @unique
  maintainerAddress String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bounties    Bounty[]
  deployments RepoDeployment[]
}

// Repo is the GitHub identity. Maintainer authority belongs to each deployment.
model RepoDeployment {
  id                String   @id @default(cuid())
  repoHash          String
  chainId           Int
  contractAddress   String
  maintainerAddress String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  repo              Repo     @relation(fields: [repoHash], references: [repoHash])

  @@unique([repoHash, chainId, contractAddress])
}

model Bounty {
  id          String @id @default(cuid())
  bountyId    String
  repoHash    String
  issueNumber Int
  metadataURI String
  status      String

  chainId         Int
  contractAddress String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repo Repo @relation(fields: [repoHash], references: [repoHash])

  assets             BountyAsset[]
  fundings           Funding[]
  claims             Claim[]
  payouts            Payout[]
  refunds            Refund[]
  linkedPullRequests LinkedPullRequest[]

  @@unique([repoHash, issueNumber, chainId, contractAddress])
  @@unique([bountyId, chainId, contractAddress])
}

model LinkedPullRequest {
  id         String   @id @default(cuid())
  bountyDbId String
  bountyId   String
  prUrl      String
  author     String?
  createdAt  DateTime @default(now())

  bounty Bounty @relation(fields: [bountyDbId], references: [id])

  @@unique([bountyDbId, prUrl])
  @@index([bountyDbId])
}

model BountyAsset {
  id         String   @id @default(cuid())
  bountyDbId String
  bountyId   String
  token      String // 0x... or 0x000... for ETH
  escrowed   String   @default("0")
  funded     String   @default("0")
  paid       String   @default("0")
  updatedAt  DateTime @updatedAt

  bounty Bounty @relation(fields: [bountyDbId], references: [id])

  @@unique([bountyDbId, token])
  @@index([bountyDbId])
}

model Funding {
  id          String   @id @default(cuid())
  bountyDbId  String
  bountyId    String
  token       String
  funder      String
  amountWei   String
  lockedUntil Int
  txHash      String
  logIndex    Int
  blockNumber Int
  createdAt   DateTime @default(now())

  bounty Bounty @relation(fields: [bountyDbId], references: [id])

  @@unique([bountyDbId, txHash, logIndex])
  @@index([bountyDbId])
}

model Claim {
  id          String   @id @default(cuid())
  bountyDbId  String
  bountyId    String
  claimId     Int
  claimer     String
  metadataURI String
  txHash      String
  logIndex    Int
  blockNumber Int
  createdAt   DateTime @default(now())

  bounty Bounty @relation(fields: [bountyDbId], references: [id])

  @@unique([bountyDbId, claimId])
  @@unique([bountyDbId, txHash, logIndex])
  @@index([bountyDbId])
}

model Payout {
  id          String   @id @default(cuid())
  bountyDbId  String
  bountyId    String
  token       String
  recipient   String
  amountWei   String
  txHash      String
  logIndex    Int
  blockNumber Int
  createdAt   DateTime @default(now())

  bounty Bounty @relation(fields: [bountyDbId], references: [id])

  @@unique([bountyDbId, txHash, logIndex])
  @@index([bountyDbId])
}

model Refund {
  id          String   @id @default(cuid())
  bountyDbId  String
  bountyId    String
  token       String
  funder      String
  amountWei   String
  txHash      String
  logIndex    Int
  blockNumber Int
  createdAt   DateTime @default(now())

  bounty Bounty @relation(fields: [bountyDbId], references: [id])

  @@unique([bountyDbId, txHash, logIndex])
  @@index([bountyDbId])
}

model IndexerState {
  id              String   @id @default(cuid())
  chainId         Int
  contractAddress String
  lastBlock       Int
  updatedAt       DateTime @updatedAt

  @@unique([chainId, contractAddress])
}

model GithubSession {
  id            String   @id
  accessToken   String
  userLogin     String
  userId        Int
  userAvatarUrl String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([expiresAt])
}

model ApiSession {
  id                   String   @id @default(cuid())
  tokenHash            String   @unique
  githubAccessTokenEnc String
  userLogin            String
  userId               Int
  userAvatarUrl        String?
  label                String?
  createdAt            DateTime @default(now())
  expiresAt            DateTime

  @@index([expiresAt])
  @@index([userLogin])
}

model GithubDeviceAuth {
  id              String   @id @default(cuid())
  deviceCodeHash  String   @unique
  userCode        String
  verificationUri String
  interval        Int
  scope           String?
  label           String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([expiresAt])
}
